# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Studio is open in local development with none of these set. You only need them to
# reach Studio in production, or to exercise the real commit path locally.

# Basic-auth password for /studio and /api/studio/*.
# Without it, production returns 404 for those paths.
STUDIO_PASSWORD=

# Basic-auth username. Optional, defaults to "tim".
STUDIO_USER=tim

# Fine-grained GitHub PAT, scoped to this repo, with Contents: read and write.
# Studio commits content with it. Without it, saving is refused in production.
GITHUB_TOKEN=

# Optional — these defaults are correct for this repo.
# GITHUB_REPO=timherden/thought-publisher
# GITHUB_BRANCH=main

# Optional — set once a custom domain is pointed, so og:image URLs are absolute.
# SITE_URL=https://timherden.com
